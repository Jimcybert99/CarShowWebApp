@page
@model CarShowJudging.Web.Pages.ErrorModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Error";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something went wrong — Car Show Judging</title>
    <base href="~/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow" style="min-width:360px;max-width:600px">
        <div class="card-header bg-dark text-white text-center py-3">
            <h4 class="mb-0">&#9888;&#65039; Something went wrong</h4>
        </div>
        <div class="card-body p-4">
            <p>An unexpected error occurred while processing your request.</p>
            @if (Model.ShowRequestId)
            {
                <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
            }
            <a href="/" class="btn btn-dark w-100">Return to Home</a>
        </div>
    </div>
</div>
</body>
</html>
