@page "/forgot-password"
@model CarShowJudging.Web.Pages.Auth.ForgotPasswordModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — Car Show Judging</title>
    <base href="~/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow" style="min-width:360px">
        <div class="card-header bg-dark text-white text-center py-3">
            <h4 class="mb-0">&#127942; Car Show Judging</h4>
        </div>
        <div class="card-body p-4">
            <h5 class="card-title mb-3">Reset Password</h5>
            @if (Model.EmailSent)
            {
                <div class="alert alert-success">
                    If that account has an email on file, a password reset link has been sent to it.
                    If not, ask an admin for help.
                </div>
                <a href="/forgot-password" class="btn btn-outline-secondary btn-sm">Reset another account</a>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Input.UserName" class="form-label">Username</label>
                        <input asp-for="Input.UserName" class="form-control" autofocus />
                    </div>
                    <button type="submit" class="btn btn-dark w-100">Send Reset Link</button>
                </form>
            }
        </div>
        <div class="card-footer text-center">
            <a href="/login">Back to Sign In</a>
        </div>
    </div>
</div>
</body>
</html>
