@page "/"
@attribute [Authorize]

<PageTitle>Home — Car Show Judging</PageTitle>

<div class="text-center py-5">
    <h1 class="display-4"><i class="bi bi-trophy-fill text-warning"></i> Car Show Judging</h1>
    <AuthorizeView Roles="Judge,Admin,SuperUser">
        <Authorized>
            <p class="lead text-muted">Welcome! Use the navigation above to register a vehicle or judge entries.</p>
        </Authorized>
        <NotAuthorized>
            <p class="lead text-muted">Welcome! Use the navigation above to register a vehicle.</p>
        </NotAuthorized>
    </AuthorizeView>
</div>
