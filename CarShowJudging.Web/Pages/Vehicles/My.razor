@page "/vehicles/my"
@attribute [Authorize]
@inject IVehicleService VehicleService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<PageTitle>My Vehicles</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>My Vehicles</h2>
    <a href="/vehicles/register" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg"></i> Register New
    </a>
</div>

@if (_vehicles is null)
{
    <p>Loading…</p>
}
else if (_vehicles.Count == 0)
{
    <p class="text-muted">No vehicles registered yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Vehicle</th>
                    <th>Owner</th>
                    <th>Classes</th>
                    <th>Photo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in PagedVehicles)
                {
                    <tr>
                        <td class="fw-bold">@v.EntryNumber</td>
                        <td>@v.Year @v.Make @v.Model</td>
                        <td>@v.OwnerName</td>
                        <td>
                            @foreach (var c in v.Classes)
                            {
                                <span class="badge bg-secondary me-1">@c.Name</span>
                            }
                        </td>
                        <td>
                            @if (v.PhotoUrl is not null)
                            {
                                <a href="@v.PhotoUrl" target="_blank">
                                    <img src="@v.PhotoUrl" alt="photo" style="height:40px;object-fit:cover;border-radius:4px" />
                                </a>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm me-1 @(string.IsNullOrWhiteSpace(v.RegistrationNote) ? "btn-outline-secondary" : "btn-info")"
                                    title="@(string.IsNullOrWhiteSpace(v.RegistrationNote) ? "Add note" : "Edit note")"
                                    @onclick="() => ShowNote(v)">
                                <i class="bi bi-journal-text"></i>
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => AskDelete(v)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pagination TotalItems="_vehicles.Count" @bind-PageSize="_pageSize" @bind-PageNumber="_pageNumber" />
}

<ConfirmDialog @ref="_dialog"
               Title="Delete Entry"
               Message="@($"Delete entry #{_deleteTarget?.EntryNumber} ({_deleteTarget?.Year} {_deleteTarget?.Make} {_deleteTarget?.Model})? This cannot be undone.")"
               OnConfirmed="DoDeleteAsync" />

<NoteModal @ref="_noteModal" OnSaved="StateHasChanged" />

@code {
    private List<Vehicle>? _vehicles;
    private ConfirmDialog _dialog = default!;
    private NoteModal _noteModal = default!;
    private Vehicle? _deleteTarget;
    private string? _userId;
    private int? _pageSize = 25;
    private int _pageNumber = 1;

    private IEnumerable<Vehicle> PagedVehicles =>
        _pageSize.HasValue
            ? (_vehicles ?? []).Skip((_pageNumber - 1) * _pageSize.Value).Take(_pageSize.Value)
            : (_vehicles ?? []);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        _userId = user?.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId is null) return;
        _vehicles = await VehicleService.GetByOwnerAsync(_userId);
    }

    private void AskDelete(Vehicle v)
    {
        _deleteTarget = v;
        _dialog.Show();
    }

    private void ShowNote(Vehicle v) => _noteModal.Show(v);

    private async Task DoDeleteAsync()
    {
        if (_deleteTarget is null || _userId is null) return;
        await VehicleService.DeleteAsync(_deleteTarget.Id, _userId, "User");
        await LoadAsync();
    }
}
