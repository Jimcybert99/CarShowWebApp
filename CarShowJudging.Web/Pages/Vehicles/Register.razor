@page "/vehicles/register"
@attribute [Authorize]
@inject IVehicleService VehicleService
@inject IClassService ClassService
@inject INoteService NoteService
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Identity
@using System.Text
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Register Vehicle</PageTitle>
<h2>Register a Vehicle</h2>

@if (_success)
{
    <div class="alert alert-success">Entry #@_newEntryNumber registered successfully.</div>
}
@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="card" style="max-width:560px">
    <div class="card-body">
        <EditForm Model="_dto" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label">Entry Number</label>
                <select class="form-select" @bind="_dto.EntryNumber">
                    @foreach (var n in _availableNumbers)
                    {
                        <option value="@n">#@n</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Owner Name</label>
                <InputText class="form-control" @bind-Value="_dto.OwnerName" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-5">
                    <label class="form-label">Year</label>
                    <InputNumber class="form-control" @bind-Value="_dto.Year" />
                </div>
                <div class="col">
                    <label class="form-label">Make</label>
                    <InputText class="form-control" @bind-Value="_dto.Make" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Model</label>
                <InputText class="form-control" @bind-Value="_dto.Model" />
            </div>

            @if (_classes.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label">Classes <span class="text-muted small">(optional, select multiple)</span></label>
                    @foreach (var cls in _classes)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cls_@cls.Id"
                                   checked="@_selectedClassIds.Contains(cls.Id)"
                                   @onchange="e => ToggleClass(cls.Id, (bool)e.Value!)" />
                            <label class="form-check-label" for="cls_@cls.Id">@cls.Name</label>
                        </div>
                    }
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Vehicle Photo <span class="text-muted small">(optional)</span></label>
                <InputFile class="form-control" OnChange="OnPhotoSelected" accept="image/*" />
            </div>

            <div class="mb-3">
                <label class="form-label">Registration Note <span class="text-muted small">(optional)</span></label>
                <textarea class="form-control" rows="2" maxlength="1000"
                          placeholder="Condition notes, special details, observations…"
                          @bind="_registrationNote" @bind:event="oninput"></textarea>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_saving">
                @(_saving ? "Registering…" : "Register Vehicle")
            </button>
        </EditForm>
    </div>
</div>

@* CSV bulk import *@
<div class="card mt-4" style="max-width:560px">
    <div class="card-header">Bulk Import via CSV</div>
    <div class="card-body">
        <p class="small text-muted mb-2">
            CSV columns (with header row):
            <code>Owner Name, Year, Make, Model, Class, Notes</code><br />
            Class and Notes are optional. Class is matched by name (case-insensitive).
        </p>
        <div class="d-flex gap-2 align-items-center">
            <InputFile class="form-control form-control-sm" OnChange="OnCsvSelected" accept=".csv" />
            <button class="btn btn-secondary btn-sm text-nowrap"
                    @onclick="ProcessCsvAsync"
                    disabled="@(_csvFile is null || _csvProcessing)">
                @(_csvProcessing ? "Importing…" : "Import")
            </button>
        </div>

        @if (_csvResults.Count > 0)
        {
            <div class="mt-3 small" style="max-height:200px;overflow-y:auto">
                <div class="fw-semibold mb-1">
                    @_csvResults.Count(r => r.Success) succeeded,
                    @_csvResults.Count(r => !r.Success) failed
                </div>
                @foreach (var r in _csvResults)
                {
                    <div class="@(r.Success ? "text-success" : "text-danger")">
                        @(r.Success ? "✓" : "✗") @r.Message
                    </div>
                }
            </div>
        }
    </div>
</div>

<NotesPanel PageContext="@PageContexts.RegisterVehicle" PageTitle="Register Vehicle" />

@code {
    private record CsvResult(bool Success, string Message);

    private VehicleRegistrationDto _dto = new();
    private List<VehicleClass> _classes = new();
    private HashSet<int> _selectedClassIds = new();
    private List<int> _availableNumbers = new();
    private IBrowserFile? _photo;
    private string _registrationNote = string.Empty;
    private bool _saving;
    private bool _success;
    private int _newEntryNumber;
    private string? _error;
    private string _userId = string.Empty;
    private string _userDisplayName = string.Empty;

    private IBrowserFile? _csvFile;
    private bool _csvProcessing;
    private List<CsvResult> _csvResults = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = UserManager.GetUserId(auth.User) ?? string.Empty;
        if (!string.IsNullOrEmpty(_userId))
        {
            var user = await UserManager.FindByIdAsync(_userId);
            _userDisplayName = (user?.DisplayName is { Length: > 0 } dn ? dn : null)
                ?? user?.UserName
                ?? auth.User.Identity?.Name
                ?? string.Empty;
        }
        _classes = await ClassService.GetAllAsync();
        _dto.Year = DateTime.UtcNow.Year;
        await LoadAvailableNumbersAsync();
    }

    private async Task LoadAvailableNumbersAsync()
    {
        var used = await VehicleService.GetUsedEntryNumbersAsync();
        var usedSet = used.ToHashSet();
        var max = used.Count > 0 ? used.Max() : 0;
        _availableNumbers = Enumerable.Range(1, max)
            .Where(n => !usedSet.Contains(n))
            .Concat(new[] { max + 1 })
            .ToList();
        _dto.EntryNumber = max + 1;
    }

    private void ToggleClass(int id, bool selected)
    {
        if (selected) _selectedClassIds.Add(id);
        else _selectedClassIds.Remove(id);
    }

    private void OnPhotoSelected(InputFileChangeEventArgs e) => _photo = e.File;
    private void OnCsvSelected(InputFileChangeEventArgs e)
    {
        _csvFile = e.File;
        _csvResults = new();
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;
        _success = false;
        try
        {
            if (string.IsNullOrEmpty(_userId)) { _error = "Not authenticated."; return; }

            _dto.SelectedClassIds = _selectedClassIds.ToList();

            if (_photo is not null)
            {
                _dto.PhotoStream = _photo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                _dto.PhotoFileName = _photo.Name;
            }

            var vehicle = await VehicleService.RegisterAsync(_dto, _userId);
            _newEntryNumber = vehicle.EntryNumber;

            if (!string.IsNullOrWhiteSpace(_registrationNote))
            {
                await NoteService.AddAsync(null, vehicle.Id, null,
                    _userId, _userDisplayName, _registrationNote.Trim(), false);
            }

            _success = true;
            _dto = new VehicleRegistrationDto { Year = DateTime.UtcNow.Year };
            _selectedClassIds.Clear();
            _photo = null;
            _registrationNote = string.Empty;
            await LoadAvailableNumbersAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ProcessCsvAsync()
    {
        if (_csvFile is null || string.IsNullOrEmpty(_userId)) return;
        _csvProcessing = true;
        _csvResults = new();

        try
        {
            using var reader = new StreamReader(
                _csvFile.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024));
            var content = await reader.ReadToEndAsync();
            var lines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries);

            for (var i = 1; i < lines.Length; i++) // skip header row
            {
                var line = lines[i].Trim('\r', ' ');
                if (string.IsNullOrEmpty(line)) continue;

                var cols = ParseCsvLine(line);
                if (cols.Length < 4)
                {
                    _csvResults.Add(new(false, $"Row {i}: needs at least Owner Name, Year, Make, Model"));
                    continue;
                }

                try
                {
                    var ownerName = cols[0].Trim();
                    var year = int.TryParse(cols[1].Trim(), out var y) ? y : DateTime.UtcNow.Year;
                    var make = cols[2].Trim();
                    var model = cols[3].Trim();
                    var className = cols.Length > 4 ? cols[4].Trim() : string.Empty;
                    var note = cols.Length > 5 ? cols[5].Trim() : string.Empty;

                    if (string.IsNullOrWhiteSpace(ownerName) || string.IsNullOrWhiteSpace(make) || string.IsNullOrWhiteSpace(model))
                    {
                        _csvResults.Add(new(false, $"Row {i}: Owner Name, Make, and Model are required"));
                        continue;
                    }

                    var classIds = new List<int>();
                    if (!string.IsNullOrEmpty(className))
                    {
                        var cls = _classes.FirstOrDefault(c =>
                            c.Name.Equals(className, StringComparison.OrdinalIgnoreCase));
                        if (cls is not null)
                            classIds.Add(cls.Id);
                    }

                    var dto = new VehicleRegistrationDto
                    {
                        OwnerName = ownerName,
                        Year = year,
                        Make = make,
                        Model = model,
                        SelectedClassIds = classIds,
                        EntryNumber = 0 // auto-assign
                    };

                    var vehicle = await VehicleService.RegisterAsync(dto, _userId);

                    if (!string.IsNullOrWhiteSpace(note))
                        await NoteService.AddAsync(null, vehicle.Id, null,
                            _userId, _userDisplayName, note, false);

                    _csvResults.Add(new(true,
                        $"Entry #{vehicle.EntryNumber}: {year} {make} {model} — {ownerName}"));
                }
                catch (Exception ex)
                {
                    _csvResults.Add(new(false, $"Row {i}: {ex.Message}"));
                }
            }

            _csvFile = null;
            await LoadAvailableNumbersAsync();
        }
        catch (Exception ex)
        {
            _csvResults.Add(new(false, $"Could not read CSV: {ex.Message}"));
        }
        finally
        {
            _csvProcessing = false;
        }
    }

    private static string[] ParseCsvLine(string line)
    {
        var result = new List<string>();
        var current = new StringBuilder();
        var inQuotes = false;

        foreach (var c in line)
        {
            if (c == '"') { inQuotes = !inQuotes; }
            else if (c == ',' && !inQuotes) { result.Add(current.ToString()); current.Clear(); }
            else { current.Append(c); }
        }
        result.Add(current.ToString());
        return result.ToArray();
    }
}
