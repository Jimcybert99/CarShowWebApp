@page "/admin/users"
@attribute [Authorize(Roles = "Admin,SuperUser")]
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PageSizePreferenceService PageSizePrefs

<PageTitle>Manage Users</PageTitle>
<h2>Manage Users</h2>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_rows is null)
{
    <p>Loading…</p>
}
else if (_rows.Count == 0)
{
    <p class="text-muted">No users found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Username</th>
                    <th>Roles</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in PagedRows)
                {
                    <tr>
                        <td>@row.User.UserName</td>
                        <td>
                            @foreach (var role in row.Roles.OrderBy(r => r))
                            {
                                var badgeClass = role switch
                                {
                                    "Admin" => "bg-danger",
                                    "SuperUser" => "bg-warning text-dark",
                                    "Judge" => "bg-primary",
                                    _ => "bg-secondary"
                                };
                                <span class="badge @badgeClass me-1">@role</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (row.User.Id == _currentUserId)
                            {
                                <span class="text-muted small">(you)</span>
                            }
                            else if (row.Roles.Contains("Admin") || (!_viewerIsAdmin && row.Roles.Contains("SuperUser")))
                            {
                                <span class="text-muted small">Locked</span>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-2 justify-content-end align-items-center">
                                    <select class="form-select form-select-sm" style="width:auto"
                                            value="@CurrentRole(row)"
                                            @onchange="e => ChangeRoleAsync(row, e.Value?.ToString())">
                                        <option value="User">User</option>
                                        <option value="Judge">Judge</option>
                                        <option value="SuperUser">SuperUser</option>
                                    </select>
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => PromptDelete(row)">
                                        Delete
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pagination TotalItems="_rows.Count" PageSize="_pageSize" PageSizeChanged="OnPageSizeChangedAsync" @bind-PageNumber="_pageNumber" />
}

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete User"
               Message="@($"Permanently delete user \"{_pendingDelete?.User.UserName}\"? This cannot be undone.")"
               ConfirmText="Delete"
               OnConfirmed="DeleteConfirmedAsync" />

@code {
    private const string PageSizeStorageKey = "admin-users";

    private List<UserRow>? _rows;
    private string? _error;
    private string? _currentUserId;
    private bool _viewerIsAdmin;
    private UserRow? _pendingDelete;
    private ConfirmDialog _confirmDialog = default!;
    private int? _pageSize = 25;
    private int _pageNumber = 1;

    private IEnumerable<UserRow> PagedRows =>
        _pageSize.HasValue
            ? (_rows ?? []).Skip((_pageNumber - 1) * _pageSize.Value).Take(_pageSize.Value)
            : (_rows ?? []);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var me = await UserManager.GetUserAsync(auth.User);
        _currentUserId = me?.Id;
        _viewerIsAdmin = auth.User.IsInRole("Admin");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var users = await UserManager.Users.OrderBy(u => u.UserName).ToListAsync();
        var rows = new List<UserRow>();
        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            rows.Add(new UserRow(user, roles.ToList()));
        }
        _rows = rows;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var (found, saved) = await PageSizePrefs.GetAsync(PageSizeStorageKey);
        if (found)
        {
            _pageSize = saved;
            StateHasChanged();
        }
    }

    private async Task OnPageSizeChangedAsync(int? newSize)
    {
        _pageSize = newSize;
        await PageSizePrefs.SetAsync(PageSizeStorageKey, newSize);
    }

    private static string CurrentRole(UserRow row) =>
        row.Roles.Contains("SuperUser") ? "SuperUser"
        : row.Roles.Contains("Judge") ? "Judge"
        : "User";

    private static readonly HashSet<string> AssignableRoles = ["User", "Judge", "SuperUser"];

    private async Task ChangeRoleAsync(UserRow row, string? newRole)
    {
        newRole ??= "User";
        _error = null;

        // A Blazor Server change-event's value comes from the client over SignalR and is NOT
        // constrained to the <option> values actually rendered — a forged event could carry any
        // string. Without this check, a SuperUser (who has legitimate access to this handler for
        // any unlocked row) could send "Admin" and grant themselves/anyone the Admin role,
        // defeating the "SuperUser can't touch Admin" rule the UI otherwise enforces.
        if (!AssignableRoles.Contains(newRole))
        {
            _error = "Invalid role.";
            return;
        }

        // Re-derive the same "is this row locked for me" rule the markup uses, rather than
        // trusting that the client only ever invokes this for a row it rendered as unlocked.
        var locked = row.User.Id == _currentUserId
            || row.Roles.Contains("Admin")
            || (!_viewerIsAdmin && row.Roles.Contains("SuperUser"));
        if (locked)
        {
            _error = "You are not allowed to change this user's role.";
            return;
        }

        foreach (var special in new[] { "Judge", "SuperUser" })
            if (row.Roles.Contains(special))
                await UserManager.RemoveFromRoleAsync(row.User, special);
        if (newRole != "User")
        {
            var result = await UserManager.AddToRoleAsync(row.User, newRole);
            if (!result.Succeeded)
            {
                _error = string.Join(", ", result.Errors.Select(e => e.Description));
                return;
            }
        }
        await LoadAsync();
    }

    private void PromptDelete(UserRow row)
    {
        _pendingDelete = row;
        _confirmDialog.Show();
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_pendingDelete is null) return;
        _error = null;
        try
        {
            var result = await UserManager.DeleteAsync(_pendingDelete.User);
            if (result.Succeeded)
                await LoadAsync();
            else
                _error = string.Join(", ", result.Errors.Select(e => e.Description));
        }
        catch (DbUpdateException)
        {
            _error = "Could not delete this user because other records still reference them.";
        }
        finally
        {
            _pendingDelete = null;
        }
    }

    private record UserRow(ApplicationUser User, List<string> Roles);
}
