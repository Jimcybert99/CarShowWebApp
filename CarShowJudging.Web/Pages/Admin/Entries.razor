@page "/admin/entries"
@attribute [Authorize(Roles = "Admin,SuperUser,Judge")]
@inject IVehicleService VehicleService
@inject AuthenticationStateProvider AuthStateProvider
@inject PageSizePreferenceService PageSizePrefs
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<PageTitle>All Entries</PageTitle>
<h2>All Entries</h2>

@if (_vehicles is null)
{
    <p>Loading…</p>
}
else if (_vehicles.Count == 0)
{
    <p class="text-muted">No entries registered yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Row #</th>
                    <th>Vehicle</th>
                    <th>Owner</th>
                    <th class="d-none d-md-table-cell">Classes</th>
                    <th>Paid</th>
                    <th>Judges Scored</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in PagedVehicles)
                {
                    <tr>
                        <td class="fw-bold">@v.EntryNumber</td>
                        <td>@(v.RowNumber?.ToString() ?? "—")</td>
                        <td>@v.Year @v.Make @v.Model</td>
                        <td>@v.OwnerName</td>
                        <td class="d-none d-md-table-cell">
                            @foreach (var c in v.Classes)
                            {
                                <span class="badge bg-secondary me-1">@c.Name</span>
                            }
                        </td>
                        <td>
                            @if (v.Paid)
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Unpaid</span>
                            }
                        </td>
                        <td>
                            @if (v.Scores.Count == 0)
                            {
                                <span class="text-muted small">None</span>
                            }
                            else
                            {
                                @foreach (var s in v.Scores)
                                {
                                    <span class="badge bg-success me-1">
                                        @(s.Judge?.UserName ?? "Judge")
                                    </span>
                                }
                            }
                        </td>
                        <td>
                            @if (_userRole is "Admin" or "SuperUser")
                            {
                                <a class="btn btn-primary btn-sm me-1" href="@($"/admin/vehicles/{v.Id}/edit?page={_pageNumber}&pageSize={PageSizeQueryValue}")">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                            <button class="btn btn-sm me-1 @(string.IsNullOrWhiteSpace(v.RegistrationNote) ? "btn-outline-secondary" : "btn-info")"
                                    title="@(string.IsNullOrWhiteSpace(v.RegistrationNote) ? "Add note" : "Edit note")"
                                    @onclick="() => ShowNote(v)">
                                <i class="bi bi-journal-text"></i>
                            </button>
                            @if (_userRole is "Admin" or "SuperUser")
                            {
                                <button class="btn btn-danger btn-sm" @onclick="() => AskDelete(v)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pagination TotalItems="_vehicles.Count" PageSize="_pageSize" PageSizeChanged="OnPageSizeChangedAsync" @bind-PageNumber="_pageNumber" />
}

<ConfirmDialog @ref="_dialog"
               Title="Delete Entry"
               Message="@($"Delete entry #{_deleteTarget?.EntryNumber} ({_deleteTarget?.Year} {_deleteTarget?.Make} {_deleteTarget?.Model})?")"
               OnConfirmed="DoDeleteAsync" />

<NoteModal @ref="_noteModal" OnSaved="StateHasChanged" />

@code {
    private const string PageSizeStorageKey = "admin-entries";

    [SupplyParameterFromQuery(Name = "page")]
    private int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    private string? PageSizeQuery { get; set; }

    private List<Vehicle>? _vehicles;
    private ConfirmDialog _dialog = default!;
    private NoteModal _noteModal = default!;
    private Vehicle? _deleteTarget;
    private string? _userId;
    private string _userRole = "Judge";
    private int? _pageSize = 25;
    private int _pageNumber = 1;
    private bool _pageSizeFromQuery;

    private string PageSizeQueryValue => _pageSize?.ToString() ?? "all";

    private IEnumerable<Vehicle> PagedVehicles =>
        _pageSize.HasValue
            ? (_vehicles ?? []).Skip((_pageNumber - 1) * _pageSize.Value).Take(_pageSize.Value)
            : (_vehicles ?? []);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        _userId = user?.Id;
        _userRole = auth.User.IsInRole("Admin") ? "Admin"
            : auth.User.IsInRole("SuperUser") ? "SuperUser"
            : "Judge";
        if (PageQuery is > 0)
            _pageNumber = PageQuery.Value;
        if (PageSizeQuery == "all")
        {
            _pageSize = null;
            _pageSizeFromQuery = true;
        }
        else if (PageSizeQuery is not null && int.TryParse(PageSizeQuery, out var ps))
        {
            _pageSize = ps;
            _pageSizeFromQuery = true;
        }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _pageSizeFromQuery) return;
        var (found, saved) = await PageSizePrefs.GetAsync(PageSizeStorageKey);
        if (found)
        {
            _pageSize = saved;
            StateHasChanged();
        }
    }

    private async Task OnPageSizeChangedAsync(int? newSize)
    {
        _pageSize = newSize;
        await PageSizePrefs.SetAsync(PageSizeStorageKey, newSize);
    }

    private async Task LoadAsync() =>
        _vehicles = await VehicleService.GetAllAsync();

    private void AskDelete(Vehicle v)
    {
        _deleteTarget = v;
        _dialog.Show();
    }

    private void ShowNote(Vehicle v) => _noteModal.Show(v);

    private async Task DoDeleteAsync()
    {
        if (_deleteTarget is null || _userId is null) return;
        await VehicleService.DeleteAsync(_deleteTarget.Id, _userId, _userRole);
        await LoadAsync();
    }
}
