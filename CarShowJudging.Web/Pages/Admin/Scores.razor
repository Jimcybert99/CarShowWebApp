@page "/admin/scores"
@attribute [Authorize(Roles = "Admin,SuperUser,Judge")]
@inject IScoreService ScoreService
@inject IClassService ClassService
@inject IJSRuntime JS
@inject PageSizePreferenceService PageSizePrefs
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Scoring Leaderboard</PageTitle>

<div class="d-flex flex-wrap align-items-end gap-3 mb-4">
    <h2 class="mb-0 me-auto">Scoring Leaderboard</h2>

    <div>
        <label class="form-label mb-1 small fw-semibold">Filter by Class</label>
        <select class="form-select form-select-sm" @onchange="OnClassChanged">
            <option value="">All Classes</option>
            @foreach (var cls in _classes)
            {
                <option value="@cls.Id">@cls.Name</option>
            }
        </select>
    </div>

    <div>
        <label class="form-label mb-1 small fw-semibold">Sort by</label>
        <select class="form-select form-select-sm" @onchange="OnSortChanged">
            <option value="">Overall Score</option>
            <option value="Exterior">Exterior (30%)</option>
            <option value="Interior">Interior (20%)</option>
            <option value="EngineBay">Engine Bay (15%)</option>
            <option value="Craftsmanship">Craftsmanship (20%)</option>
            <option value="Presentation">Presentation (15%)</option>
        </select>
    </div>

    <div>
        <button class="btn btn-success btn-sm" @onclick="DownloadSpreadsheetAsync" disabled="@(_rows is null || _rows.Count == 0)">
            <i class="bi bi-file-earmark-excel me-1"></i>Download Spreadsheet
        </button>
    </div>
</div>

@if (_rows is null)
{
    <p>Loading…</p>
}
else if (_rows.Count == 0)
{
    <p class="text-muted">No entries match the current filter.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark sticky-top">
                <tr>
                    <th style="width:50px">#</th>
                    <th>Vehicle</th>
                    <th class="d-none d-md-table-cell">Owner</th>
                    <th class="d-none d-md-table-cell">Classes</th>
                    <th class="text-center">Exterior (30%)</th>
                    <th class="text-center">Interior (20%)</th>
                    <th class="text-center">Engine Bay (15%)</th>
                    <th class="text-center">Craftsmanship (20%)</th>
                    <th class="text-center">Presentation (15%)</th>
                    <th class="text-center">Overall</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <Virtualize Items="PagedRows" Context="row">
                    <tr class="entry-row" @onclick="() => ToggleExpand(row.VehicleId)">
                        <td class="fw-bold text-center">@row.EntryNumber</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (row.PhotoUrl is not null)
                                {
                                    <img src="@row.PhotoUrl" alt="" style="height:36px;width:54px;object-fit:cover;border-radius:4px" />
                                }
                                <span>@row.Year @row.Make @row.Model</span>
                            </div>
                        </td>
                        <td class="d-none d-md-table-cell">@row.OwnerName</td>
                        <td class="d-none d-md-table-cell">
                            @foreach (var c in row.ClassNames)
                            {
                                <span class="badge bg-secondary me-1">@c</span>
                            }
                        </td>
                        <td class="text-center">@FormatScore(row.AvgExterior)</td>
                        <td class="text-center">@FormatScore(row.AvgInterior)</td>
                        <td class="text-center">@FormatScore(row.AvgEngineBay)</td>
                        <td class="text-center">@FormatScore(row.AvgCraftsmanship)</td>
                        <td class="text-center">@FormatScore(row.AvgPresentation)</td>
                        <td class="text-center fw-bold @(row.OverallScore.HasValue ? "text-success" : "text-muted")">
                            @FormatScore(row.OverallScore)
                        </td>
                        <td>
                            @if (_userRole is "Admin" or "SuperUser")
                            {
                                <button class="btn btn-danger btn-sm" @onclick:stopPropagation="true"
                                        disabled="@(row.JudgeScores.Count == 0)"
                                        title="@(row.JudgeScores.Count == 0 ? "No scores to delete" : "Delete score(s)")"
                                        @onclick="() => AskDelete(row)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                    @if (_expandedIds.Contains(row.VehicleId))
                    {
                        <tr class="table-light">
                            <td colspan="11" class="ps-4">
                                @if (row.JudgeScores.Count == 0)
                                {
                                    <span class="text-muted small">No scores submitted yet.</span>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th>Judge</th>
                                                <th class="text-center">Exterior (30%)</th>
                                                <th class="text-center">Interior (20%)</th>
                                                <th class="text-center">Engine Bay (15%)</th>
                                                <th class="text-center">Craftsmanship (20%)</th>
                                                <th class="text-center">Presentation (15%)</th>
                                                <th class="text-center">Overall</th>
                                                <th>Scored</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var js in row.JudgeScores)
                                            {
                                                <tr>
                                                    <td>@js.JudgeName</td>
                                                    <td class="text-center">@js.Exterior</td>
                                                    <td class="text-center">@js.Interior</td>
                                                    <td class="text-center">@js.EngineBay</td>
                                                    <td class="text-center">@js.Craftsmanship</td>
                                                    <td class="text-center">@js.Presentation</td>
                                                    <td class="text-center fw-bold">@js.Overall.ToString("F1")</td>
                                                    <td class="small text-muted">@js.ScoredAt.LocalDateTime.ToString("g")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </Virtualize>
            </tbody>
        </table>
    </div>
    <Pagination TotalItems="_rows.Count" PageSize="_pageSize" PageSizeChanged="OnPageSizeChangedAsync" @bind-PageNumber="_pageNumber" />
}

<ConfirmDialog @ref="_dialog"
               Title="Delete Score"
               Message="@($"Delete {_deleteTarget?.JudgeScores.FirstOrDefault()?.JudgeName}'s score for entry #{_deleteTarget?.EntryNumber} ({_deleteTarget?.Year} {_deleteTarget?.Make} {_deleteTarget?.Model})?")"
               OnConfirmed="DoDeleteSingleAsync" />

@if (_selectVisible && _deleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Scores</h5>
                </div>
                <div class="modal-body">
                    <p>
                        Entry #@_deleteTarget.EntryNumber (@_deleteTarget.Year @_deleteTarget.Make @_deleteTarget.Model)
                        has multiple scores. Select which one(s) to delete:
                    </p>
                    @foreach (var js in _deleteTarget.JudgeScores)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@($"score_{js.Id}")"
                                   checked="@_selectedScoreIds.Contains(js.Id)"
                                   @onchange="e => ToggleScoreSelection(js.Id, (bool)e.Value!)" />
                            <label class="form-check-label" for="@($"score_{js.Id}")">
                                @js.JudgeName — Overall @js.Overall.ToString("F1") (@js.ScoredAt.LocalDateTime.ToString("g"))
                            </label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _selectVisible = false">Cancel</button>
                    <button class="btn btn-danger" disabled="@(_selectedScoreIds.Count == 0)"
                            @onclick="DoDeleteSelectedAsync">
                        Delete Selected
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string PageSizeStorageKey = "admin-scores";

    private List<ScoringRowDto>? _rows;
    private List<VehicleClass> _classes = new();
    private HashSet<int> _expandedIds = new();
    private ConfirmDialog _dialog = default!;
    private ScoringRowDto? _deleteTarget;
    private bool _selectVisible;
    private HashSet<int> _selectedScoreIds = new();
    private int? _selectedClassId;
    private string? _sortBy;
    private string _userRole = "Judge";
    private int? _pageSize = 25;
    private int _pageNumber = 1;

    // _rows is already sorted/filtered server-side by GetScoringRowsAsync — paging just slices
    // that already-correct order, it never re-sorts only what's on screen.
    private List<ScoringRowDto> PagedRows =>
        (_pageSize.HasValue
            ? (_rows ?? []).Skip((_pageNumber - 1) * _pageSize.Value).Take(_pageSize.Value)
            : (_rows ?? [])).ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userRole = auth.User.IsInRole("Admin") ? "Admin"
            : auth.User.IsInRole("SuperUser") ? "SuperUser"
            : "Judge";
        _classes = await ClassService.GetAllAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _rows = await ScoreService.GetScoringRowsAsync(_selectedClassId, _sortBy);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var (found, saved) = await PageSizePrefs.GetAsync(PageSizeStorageKey);
        if (found)
        {
            _pageSize = saved;
            StateHasChanged();
        }
    }

    private async Task OnPageSizeChangedAsync(int? newSize)
    {
        _pageSize = newSize;
        await PageSizePrefs.SetAsync(PageSizeStorageKey, newSize);
    }

    private async Task OnClassChanged(ChangeEventArgs e)
    {
        _selectedClassId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!);
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        _sortBy = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        _pageNumber = 1;
        await LoadAsync();
    }

    private void ToggleExpand(int id)
    {
        if (!_expandedIds.Remove(id))
            _expandedIds.Add(id);
    }

    private void AskDelete(ScoringRowDto row)
    {
        if (row.JudgeScores.Count == 0) return;

        _deleteTarget = row;
        if (row.JudgeScores.Count == 1)
        {
            _dialog.Show();
        }
        else
        {
            _selectedScoreIds.Clear();
            _selectVisible = true;
        }
    }

    private void ToggleScoreSelection(int scoreId, bool selected)
    {
        if (selected) _selectedScoreIds.Add(scoreId);
        else _selectedScoreIds.Remove(scoreId);
    }

    private async Task DoDeleteSingleAsync()
    {
        var scoreId = _deleteTarget?.JudgeScores.FirstOrDefault()?.Id;
        if (scoreId is null) return;
        await ScoreService.DeleteScoresAsync(new[] { scoreId.Value }, _userRole);
        await LoadAsync();
    }

    private async Task DoDeleteSelectedAsync()
    {
        if (_selectedScoreIds.Count == 0) return;
        await ScoreService.DeleteScoresAsync(_selectedScoreIds, _userRole);
        _selectVisible = false;
        _selectedScoreIds.Clear();
        await LoadAsync();
    }

    private static string FormatScore(double? v) => v.HasValue ? v.Value.ToString("F1") : "—";

    private async Task DownloadSpreadsheetAsync()
    {
        if (_rows is null || _rows.Count == 0) return;

        var className = _selectedClassId.HasValue
            ? _classes.FirstOrDefault(c => c.Id == _selectedClassId.Value)?.Name
            : null;

        var bytes = ScoreSpreadsheetExporter.BuildWorkbook(_rows, className, _sortBy);
        var fileName = ScoreSpreadsheetExporter.BuildFileName(className, _sortBy);
        const string contentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";

        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, Convert.ToBase64String(bytes));
    }
}
