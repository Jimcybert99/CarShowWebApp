@page "/judge/entries/{VehicleId:int}/score"
@attribute [Authorize(Roles = "Judge,Admin,SuperUser")]
@inject IVehicleService VehicleService
@inject IScoreService ScoreService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Score Entry</PageTitle>

@if (_vehicle is null)
{
    <p>Loading…</p>
}
else
{
    <div class="d-flex align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-0">Entry #@_vehicle.EntryNumber</h2>
            <p class="text-muted mb-0">@_vehicle.Year @_vehicle.Make @_vehicle.Model — @_vehicle.OwnerName</p>
            @foreach (var c in _vehicle.Classes)
            {
                <span class="badge bg-secondary me-1">@c.Name</span>
            }
        </div>
        @if (_vehicle.PhotoUrl is not null)
        {
            <img src="@_vehicle.PhotoUrl" alt="vehicle photo" style="height:80px;border-radius:8px;object-fit:cover" />
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div class="card" style="max-width:480px">
        <div class="card-body">
            <h5 class="card-title">Score Each Criteria (1–10)</h5>
            <CriteriaInput Label="Exterior (30%)" @bind-Value="_dto.Exterior" />
            <CriteriaInput Label="Interior (20%)" @bind-Value="_dto.Interior" />
            <CriteriaInput Label="Engine/Engine Bay (15%)" @bind-Value="_dto.EngineBay" />
            <CriteriaInput Label="Craftsmanship &amp; Details (20%)" @bind-Value="_dto.Craftsmanship" />
            <CriteriaInput Label="Overall Presentation (15%)" @bind-Value="_dto.Presentation" />

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_saving">
                    @(_saving ? "Submitting…" : "Submit Score")
                </button>
                <a href="/judge/entries" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

<ScoreConfirmationModal @ref="_modal" OnClosed="ReturnToEntries" />

@code {
    [Parameter] public int VehicleId { get; set; }

    private Vehicle? _vehicle;
    private ScoreSubmitDto _dto = new();
    private bool _saving;
    private string? _error;
    private ScoreConfirmationModal _modal = default!;
    private string? _judgeId;
    private CarShowJudging.Core.Models.Score? _submittedScore;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        _judgeId = user?.Id;

        _vehicle = await VehicleService.GetByIdAsync(VehicleId);
        if (_vehicle is null) { Nav.NavigateTo("/judge/entries"); return; }

        _dto.VehicleId = VehicleId;
        _dto.JudgeId = _judgeId ?? string.Empty;

        if (_judgeId is not null)
        {
            var existing = await ScoreService.GetByVehicleAndJudgeAsync(VehicleId, _judgeId);
            if (existing is not null)
            {
                _dto.Exterior = existing.Exterior;
                _dto.Interior = existing.Interior;
                _dto.EngineBay = existing.EngineBay;
                _dto.Craftsmanship = existing.Craftsmanship;
                _dto.Presentation = existing.Presentation;
            }
        }
    }

    private async Task SubmitAsync()
    {
        if (!ValidateScores()) return;
        _saving = true;
        _error = null;
        try
        {
            _submittedScore = await ScoreService.SubmitAsync(_dto);
            _modal.Show(_submittedScore, _vehicle!);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private bool ValidateScores()
    {
        var values = new[] { _dto.Exterior, _dto.Interior, _dto.EngineBay, _dto.Craftsmanship, _dto.Presentation };
        if (values.Any(v => v < 1 || v > 10))
        {
            _error = "All scores must be between 1 and 10.";
            return false;
        }
        return true;
    }

    private void ReturnToEntries() => Nav.NavigateTo("/judge/entries");
}
