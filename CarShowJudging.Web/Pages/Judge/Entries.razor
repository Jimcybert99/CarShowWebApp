@page "/judge/entries"
@attribute [Authorize(Roles = "Judge,Admin,SuperUser")]
@inject IVehicleService VehicleService
@inject IScoreService ScoreService
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Entries to Judge</PageTitle>
<h2>Entries</h2>
<p class="text-muted">Select an entry to submit your scores.</p>

@if (_vehicles is null)
{
    <p>Loading…</p>
}
else if (_vehicles.Count == 0)
{
    <p class="text-muted">No entries registered yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width:60px">#</th>
                    <th style="width:70px">Photo</th>
                    <th>Vehicle</th>
                    <th>Owner</th>
                    <th class="d-none d-md-table-cell">Classes</th>
                    <th>Your Score</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in PagedVehicles)
                {
                    var scored = _scoredIds.Contains(v.Id);
                    <tr class="entry-row">
                        <td class="fw-bold text-center">@v.EntryNumber</td>
                        <td>
                            @if (v.PhotoUrl is not null)
                            {
                                <img src="@v.PhotoUrl" alt="photo"
                                     style="height:40px;width:60px;object-fit:cover;border-radius:4px;cursor:pointer"
                                     @onclick="() => ShowPhoto(v.PhotoUrl!)" />
                            }
                        </td>
                        <td>@v.Year @v.Make @v.Model</td>
                        <td>@v.OwnerName</td>
                        <td class="d-none d-md-table-cell">
                            @foreach (var c in v.Classes)
                            {
                                <span class="badge bg-secondary me-1">@c.Name</span>
                            }
                        </td>
                        <td>
                            @if (scored)
                            {
                                <span class="badge bg-success">Scored</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Not scored</span>
                            }
                        </td>
                        <td>
                            <a href="/judge/entries/@v.Id/score" class="btn btn-primary btn-sm">
                                @(scored ? "Re-score" : "Score")
                            </a>
                        </td>
                        <td>
                            <button class="btn btn-sm @(string.IsNullOrWhiteSpace(v.RegistrationNote) ? "btn-outline-secondary" : "btn-info")"
                                    title="@(string.IsNullOrWhiteSpace(v.RegistrationNote) ? "Add note" : "Edit note")"
                                    @onclick="() => ShowNote(v)">
                                <i class="bi bi-journal-text"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pagination TotalItems="_vehicles.Count" @bind-PageSize="_pageSize" @bind-PageNumber="_pageNumber" />
}

<NoteModal @ref="_noteModal" OnSaved="StateHasChanged" />

<ImageLightbox @ref="_lightbox" />

@code {
    private List<Vehicle>? _vehicles;
    private HashSet<int> _scoredIds = new();
    private string _judgeId = string.Empty;
    private NoteModal _noteModal = default!;
    private ImageLightbox _lightbox = default!;
    private int? _pageSize = 25;
    private int _pageNumber = 1;

    private IEnumerable<Vehicle> PagedVehicles =>
        _pageSize.HasValue
            ? (_vehicles ?? []).Skip((_pageNumber - 1) * _pageSize.Value).Take(_pageSize.Value)
            : (_vehicles ?? []);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        _judgeId = user?.Id ?? string.Empty;

        _vehicles = await VehicleService.GetAllAsync();

        if (!string.IsNullOrEmpty(_judgeId))
            _scoredIds = await ScoreService.GetScoredVehicleIdsForJudgeAsync(_judgeId);
    }

    private void ShowNote(Vehicle v) => _noteModal.Show(v);

    private void ShowPhoto(string url) => _lightbox.Show(url);
}
