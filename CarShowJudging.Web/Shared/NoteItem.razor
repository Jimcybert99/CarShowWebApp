@inject INoteService NoteService

<div class="note-item @(Note.IsImportant ? "note-important" : "")">
    <div class="note-header">
        <div class="note-meta">
            <strong class="small">@Note.AuthorDisplayName</strong>
            @if (Note.IsImportant)
            {
                <i class="bi bi-star-fill text-warning ms-1" style="font-size:.7rem" title="Important"></i>
            }
            <small class="text-muted ms-2">@Note.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</small>
            @if (Note.EditedAt.HasValue)
            {
                <small class="text-muted fst-italic ms-1">(edited @Note.EditedAt.Value.ToLocalTime().ToString("MMM d, h:mm tt"))</small>
            }
        </div>
        <div class="note-actions">
            @if (CanEditNote(Note))
            {
                <button class="btn btn-link btn-sm p-0 me-2 text-muted" title="Edit" @onclick="StartEdit">
                    <i class="bi bi-pencil"></i>
                </button>
            }
            @if (CanDeleteNote(Note))
            {
                <button class="btn btn-link btn-sm p-0 text-danger" title="Delete" @onclick="DeleteAsync">
                    <i class="bi bi-trash"></i>
                </button>
            }
        </div>
    </div>

    @if (_editing)
    {
        <textarea class="form-control form-control-sm mt-1" rows="2"
                  @bind="_editText" @bind:event="oninput" maxlength="1000"></textarea>
        <div class="d-flex justify-content-between align-items-center mt-1">
            @if (CanMarkImportant)
            {
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="edit_imp_@Note.Id" @bind="_editImportant" />
                    <label class="form-check-label small" for="edit_imp_@Note.Id">
                        <i class="bi bi-star text-warning"></i> Important
                    </label>
                </div>
            }
            else
            {
                <span></span>
            }
            <div class="d-flex gap-2">
                <button class="btn btn-link btn-sm p-0 text-muted" @onclick="CancelEdit">Cancel</button>
                <button class="btn btn-primary btn-sm" @onclick="SaveEditAsync"
                        disabled="@string.IsNullOrWhiteSpace(_editText)">Save</button>
            </div>
        </div>
    }
    else
    {
        <div class="note-content small mt-1">@Note.Content</div>
    }

    @if (_error is not null)
    {
        <div class="small text-danger mt-1">@_error</div>
    }

    @* Replies *@
    @foreach (var reply in Note.Replies.OrderBy(r => r.Id))
    {
        <div class="note-reply">
            <div class="note-header">
                <div class="note-meta">
                    <i class="bi bi-arrow-return-right text-muted me-1" style="font-size:.7rem"></i>
                    <strong class="small">@reply.AuthorDisplayName</strong>
                    @if (reply.IsImportant)
                    {
                        <i class="bi bi-star-fill text-warning ms-1" style="font-size:.7rem"></i>
                    }
                    <small class="text-muted ms-2">@reply.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</small>
                    @if (reply.EditedAt.HasValue)
                    {
                        <small class="text-muted fst-italic ms-1">(edited)</small>
                    }
                </div>
                <div class="note-actions">
                    @if (CanEditNote(reply))
                    {
                        <button class="btn btn-link btn-sm p-0 me-2 text-muted" title="Edit"
                                @onclick="() => StartReplyEdit(reply)">
                            <i class="bi bi-pencil"></i>
                        </button>
                    }
                    @if (CanDeleteNote(reply))
                    {
                        <button class="btn btn-link btn-sm p-0 text-danger" title="Delete"
                                @onclick="async () => await DeleteReplyAsync(reply.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            </div>
            @if (_editingReplyId == reply.Id)
            {
                <textarea class="form-control form-control-sm mt-1" rows="2"
                          @bind="_editReplyText" @bind:event="oninput" maxlength="1000"></textarea>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    @if (CanMarkImportant)
                    {
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="redit_imp_@reply.Id" @bind="_editReplyImportant" />
                            <label class="form-check-label small" for="redit_imp_@reply.Id">
                                <i class="bi bi-star text-warning"></i> Important
                            </label>
                        </div>
                    }
                    else
                    {
                        <span></span>
                    }
                    <div class="d-flex gap-2">
                        <button class="btn btn-link btn-sm p-0 text-muted" @onclick="CancelReplyEdit">Cancel</button>
                        <button class="btn btn-primary btn-sm" @onclick="SaveReplyEditAsync"
                                disabled="@string.IsNullOrWhiteSpace(_editReplyText)">Save</button>
                    </div>
                </div>
            }
            else
            {
                <div class="note-content small mt-1">@reply.Content</div>
            }
        </div>
    }

    @* Reply form *@
    @if (CanReply && !_replying)
    {
        <button class="btn btn-link btn-sm p-0 mt-1 text-muted small" @onclick="() => _replying = true">
            <i class="bi bi-reply"></i> Reply
        </button>
    }
    @if (_replying)
    {
        <div class="note-reply-form mt-1">
            <textarea class="form-control form-control-sm" rows="2" placeholder="Write a reply…"
                      @bind="_replyText" @bind:event="oninput" maxlength="1000"></textarea>
            <div class="d-flex justify-content-between align-items-center mt-1">
                <div class="d-flex gap-2 align-items-center">
                    @if (CanMarkImportant)
                    {
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="reply_imp_@Note.Id" @bind="_replyImportant" />
                            <label class="form-check-label small" for="reply_imp_@Note.Id">
                                <i class="bi bi-star text-warning"></i> Important
                            </label>
                        </div>
                    }
                    <button class="btn btn-link btn-sm p-0 text-muted" @onclick="CancelReply">Cancel</button>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SubmitReplyAsync"
                        disabled="@string.IsNullOrWhiteSpace(_replyText)">Reply</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SiteNote Note { get; set; } = null!;
    [Parameter, EditorRequired] public string UserId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string UserDisplayName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string UserRole { get; set; } = string.Empty;
    [Parameter] public bool CanReply { get; set; } = true;
    [Parameter] public EventCallback OnChanged { get; set; }

    bool CanMarkImportant => UserRole is "Admin" or "Judge";
    bool CanEditNote(SiteNote n) => !string.IsNullOrEmpty(UserId) && n.AuthorId == UserId;
    bool CanDeleteNote(SiteNote n) => !string.IsNullOrEmpty(UserId) && (n.AuthorId == UserId || UserRole == "Admin");

    bool _editing, _replying;
    string _editText = string.Empty;
    bool _editImportant;
    int? _editingReplyId;
    string _editReplyText = string.Empty;
    bool _editReplyImportant;
    string _replyText = string.Empty;
    bool _replyImportant;
    string? _error;

    void StartEdit()
    {
        _editing = true;
        _editText = Note.Content;
        _editImportant = Note.IsImportant;
        _error = null;
    }

    void CancelEdit() => _editing = false;

    async Task SaveEditAsync()
    {
        _error = null;
        try
        {
            await NoteService.EditAsync(Note.Id, UserId, UserRole == "Admin", _editText.Trim(), _editImportant);
            _editing = false;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    async Task DeleteAsync()
    {
        _error = null;
        try
        {
            await NoteService.DeleteAsync(Note.Id, UserId, UserRole == "Admin");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    void StartReplyEdit(SiteNote reply)
    {
        _editingReplyId = reply.Id;
        _editReplyText = reply.Content;
        _editReplyImportant = reply.IsImportant;
        _error = null;
    }

    void CancelReplyEdit() => _editingReplyId = null;

    async Task SaveReplyEditAsync()
    {
        if (_editingReplyId is null) return;
        _error = null;
        try
        {
            await NoteService.EditAsync(_editingReplyId.Value, UserId, UserRole == "Admin",
                _editReplyText.Trim(), _editReplyImportant);
            _editingReplyId = null;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    async Task DeleteReplyAsync(int replyId)
    {
        _error = null;
        try
        {
            await NoteService.DeleteAsync(replyId, UserId, UserRole == "Admin");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    void CancelReply()
    {
        _replying = false;
        _replyText = string.Empty;
        _replyImportant = false;
    }

    async Task SubmitReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(_replyText)) return;
        _error = null;
        try
        {
            await NoteService.AddAsync(null, null, Note.Id, UserId, UserDisplayName, _replyText.Trim(), _replyImportant);
            _replying = false;
            _replyText = string.Empty;
            _replyImportant = false;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
