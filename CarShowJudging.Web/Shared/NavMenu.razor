@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="bi bi-trophy-fill text-warning me-2"></i>Car Show Judging
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="vehicles/my">My Vehicles</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="vehicles/register">Register Vehicle</NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Judge,Admin,SuperUser">
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="judge/entries">Entries to Judge</NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin,SuperUser">
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="admin/entries">All Entries</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="admin/scores">Scores</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="admin/classes">Classes</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="admin/users">Users</NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>

            <ul class="navbar-nav">
                <li class="nav-item">
                    <button class="nav-link btn btn-link" title="Toggle dark mode" @onclick="ToggleDarkModeAsync">
                        <i class="bi @(_isDark ? "bi-sun-fill" : "bi-moon-fill")"></i>
                    </button>
                </li>
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="account/profile">
                                <i class="bi bi-person-circle me-1"></i>@context.User.Identity!.Name
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="logout">Logout</a>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="login">Login</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="register">Register</NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

@code {
    private bool _isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("darkMode.get");
            _isDark = theme == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleDarkModeAsync()
    {
        var theme = await JS.InvokeAsync<string>("darkMode.toggle");
        _isDark = theme == "dark";
    }
}
