@if (_visible)
{
    <div class="lightbox-overlay" @onclick="Close">
        <img src="@_photoUrl" alt="Vehicle photo" class="lightbox-image" @onclick:stopPropagation="true" />
    </div>
}

@code {
    private bool _visible;
    private string? _photoUrl;

    public void Show(string photoUrl)
    {
        _photoUrl = photoUrl;
        _visible = true;
        StateHasChanged();
    }

    private void Close() => _visible = false;
}
