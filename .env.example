# Copy to .env next to docker-compose.yml (never commit the real .env)

# Which optional service(s) to run alongside the app:
#   - Plan D (local self-host via Cloudflare Tunnel): cloudflare
#   - Plan C (VPS via Caddy):                          vps
COMPOSE_PROFILES=cloudflare

# Plan D only — from Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > "Install and run a connector"
CLOUDFLARE_TUNNEL_TOKEN=

# Plan C only — your DuckDNS subdomain, without ".duckdns.org" (e.g. "carshowjudging")
DUCKDNS_SUBDOMAIN=

# Required — the app refuses to start outside Development without this
SEED__ADMINPASSWORD=

# Optional — leave blank to leave "Forgot password" disabled
SMTP_USER=
SMTP_PASSWORD=

# Which image docker compose pulls; scripts/poll-deploy.ps1 keeps this current
IMAGE=ghcr.io/jimcybert99/carshowwebapp:latest
